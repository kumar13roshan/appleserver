# AppleServer Backend - Environment Configuration Example

# Define your Gemini API Keys here. You can add a single key or multiple keys for round-robin rotation.
GEMINI_API_KEY=YOUR_FIRST_GEMINI_API_KEY
GEMINI_API_KEY_2=YOUR_SECOND_GEMINI_API_KEY
GEMINI_API_KEY_3=YOUR_THIRD_GEMINI_API_KEY

# Port configuration
PORT=3000
